{
  "$schema": "https://json.schemastore.org/package",
  "name": "@strapi-community/plugin-io",
  "version": "5.8.3",
  "description": "Socket.IO plugin for Strapi 5: real-time content events with Strapi permissions, admin presence and monitoring.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "plugin",
    "strapi plugin",
    "socket",
    "socket io",
    "io"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./types.d.ts",
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "types.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.{js,mjs}\"",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "prepack": "npm run build",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.mjs\"",
    "test:e2e:app": "node scripts/e2e-app.mjs"
  },
  "dependencies": {
    "@strapi/utils": "^5.61.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.61.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "koa": "^3.3.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.6.0",
    "typescript": "^5.9.3",
    "ws": "^8.22.1"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.0",
    "@strapi/icons": "^2.2.0",
    "@strapi/strapi": "^5.13.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6.30.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "name": "io",
    "displayName": "IO",
    "description": "Socket.IO plugin for Strapi 5: real-time content events with Strapi permissions, admin presence and monitoring.",
    "kind": "plugin"
  },
  "engines": {
    "node": "^22.21.0 || >=24.9.0 <=26.x.x"
  },
  "author": {
    "name": "@ComfortablyCoding",
    "url": "https://github.com/ComfortablyCoding"
  },
  "maintainers": [
    {
      "name": "@ComfortablyCoding",
      "url": "https://github.com/ComfortablyCoding",
      "lead": true
    },
    {
      "name": "@hrdunn",
      "url": "https://github.com/hrdunn"
    }
  ],
  "homepage": "https://strapi-community.github.io/plugin-io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/strapi-community/plugin-io.git"
  },
  "bugs": {
    "url": "https://github.com/strapi-community/plugin-io/issues"
  },
  "license": "MIT",
  "types": "./types.d.ts",
  "overrides": {
    "zod@4.4.3": "^4.6.7",
    "nodemailer": "^10.3.1",
    "koa-body": {
      "zod": "^4.6.7"
    },
    "@modelcontextprotocol/node": {
      "@hono/node-server": "^2.1.6"
    }
  }
}
